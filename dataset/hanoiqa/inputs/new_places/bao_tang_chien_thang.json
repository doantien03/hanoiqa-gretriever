    {"key": "ev_address", "source": "src_b52_military_museum_2026", "topic": "official_address", "normalized_text": "Bảo tàng Chiến thắng B-52 có địa chỉ tại số 157 phố Đội Cấn, phường Ngọc Hà, thành phố Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_establishment", "source": "src_b52_qptd_2023", "topic": "establishment", "normalized_text": "Ngày 10 tháng 1 năm 1986, Quân khu Thủ đô ban hành Quyết định số 401 thành lập Bảo tàng Chiến thắng B-52, trực thuộc Cục Chính trị.", "text_kind": "normalized_summary"},
    {"key": "ev_management", "source": "src_b52_military_museum_2026", "topic": "management", "normalized_text": "Bảo tàng Chiến thắng B-52 trực thuộc Cục Chính trị Bộ Tư lệnh Thủ đô Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_category", "source": "src_b52_official_intro", "topic": "museum_category", "normalized_text": "Bảo tàng Chiến thắng B-52 thuộc loại hình bảo tàng lịch sử quân sự.", "text_kind": "normalized_summary"},
    {"key": "ev_museum_rank", "source": "src_b52_official_intro", "topic": "museum_rank", "normalized_text": "Bảo tàng Chiến thắng B-52 được xếp hạng II trong hệ thống bảo tàng Việt Nam.", "text_kind": "normalized_summary"},
    {"key": "ev_inauguration", "source": "src_b52_qptd_2023", "topic": "inauguration", "normalized_text": "Bảo tàng Chiến thắng B-52 được xây mới và khánh thành ngày 22 tháng 12 năm 1997 nhân dịp kỷ niệm 25 năm Chiến thắng Hà Nội - Điện Biên Phủ trên không.", "text_kind": "normalized_summary"},
    {"key": "ev_display_areas", "source": "src_b52_military_museum_2026", "topic": "display_areas", "normalized_text": "Bảo tàng Chiến thắng B-52 gồm khu trưng bày trong nhà và khu trưng bày ngoài trời.", "text_kind": "normalized_summary"},
    {"key": "ev_outdoor_objects", "source": "src_b52_military_museum_2026", "topic": "outdoor_objects", "normalized_text": "Khu trưng bày ngoài trời của Bảo tàng Chiến thắng B-52 giới thiệu ra-đa dẫn đường P-35, bệ phóng tên lửa SAM-2 và xác máy bay B-52.", "text_kind": "normalized_summary"},
    {"key": "ev_radar_p35", "source": "src_b52_qptd_2019", "topic": "radar_p35", "normalized_text": "Ra-đa dẫn đường P-35 của Đại đội 45, Trung đoàn 291 được sử dụng để phát hiện sớm máy bay B-52 đánh vào Hà Nội ngày 18 tháng 12 năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_sam2_launcher", "source": "src_b52_qptd_2019", "topic": "sam2_launcher", "normalized_text": "Bệ phóng tên lửa SAM-2 của Tiểu đoàn 72, Trung đoàn 285 được sử dụng trong trận bắn rơi tại chỗ một máy bay B-52 lúc 23 giờ 05 phút ngày 27 tháng 12 năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_b52_wreck", "source": "src_b52_military_museum_2026", "topic": "b52_wreck", "normalized_text": "Khu trưng bày ngoài trời của Bảo tàng Chiến thắng B-52 có xác máy bay B-52 được phục dựng theo tỷ lệ 1:1 với thân dài 49,05 mét và sải cánh 56,39 mét.", "text_kind": "normalized_summary"},
    {"key": "ev_indoor_content", "source": "src_b52_military_museum_2026", "topic": "indoor_display_purpose", "normalized_text": "Khu trưng bày trong nhà của Bảo tàng Chiến thắng B-52 giới thiệu truyền thống của lực lượng vũ trang Thủ đô và diễn biến Chiến thắng Hà Nội - Điện Biên Phủ trên không.", "text_kind": "normalized_summary"},
    {"key": "ev_outdoor_use", "source": "src_b52_military_museum_2026", "topic": "outdoor_display_purpose", "normalized_text": "Khu trưng bày ngoài trời của Bảo tàng Chiến thắng B-52 được sử dụng để giới thiệu vũ khí, khí tài và xác máy bay gắn với chiến thắng tháng 12 năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_visitor_activities", "source": "src_b52_qptd_2023", "topic": "visitor_activities", "normalized_text": "Bảo tàng Chiến thắng B-52 tạo điều kiện cho học sinh, sinh viên và nhân dân tham quan trưng bày, học tập, tìm hiểu lịch sử và giáo dục truyền thống của lực lượng vũ trang Thủ đô.", "text_kind": "normalized_summary"},
    {"key": "ev_renovation_2012_2019", "source": "src_b52_qptd_2023", "topic": "renovation_years", "normalized_text": "Bảo tàng Chiến thắng B-52 được đầu tư nâng cấp, tu sửa vào các năm 2012, 2017 và 2019.", "text_kind": "normalized_summary"},
    {"key": "ev_renovation_period_2022", "source": "src_b52_renovation_2022", "topic": "renovation_period_2022", "normalized_text": "Công trình cải tạo, nâng cấp Bảo tàng Chiến thắng B-52 được thi công từ tháng 8 đến tháng 12 năm 2022.", "text_kind": "normalized_summary"},
    {"key": "ev_renovation_inauguration_2022", "source": "src_b52_renovation_2022", "topic": "renovation_inauguration_2022", "normalized_text": "Công trình cải tạo, nâng cấp Bảo tàng Chiến thắng B-52 được khánh thành ngày 11 tháng 12 năm 2022.", "text_kind": "normalized_summary"},
    {"key": "ev_digital_model", "source": "src_b52_qptd_2023", "topic": "digital_campaign_model", "normalized_text": "Sau đợt cải tạo năm 2022, Bảo tàng Chiến thắng B-52 có phòng sa bàn được làm mới và áp dụng công nghệ 3D mapping để trình chiếu phim tư liệu, hỗ trợ khách tham quan tìm hiểu diễn biến và ý nghĩa chiến dịch.", "text_kind": "normalized_summary"},
    {"key": "ev_deputy_director", "source": "src_b52_personnel_2026", "topic": "museum_personnel", "normalized_text": "Thượng tá quân nhân chuyên nghiệp Trịnh Thị Khuyến Lương giữ chức Phó Giám đốc Bảo tàng Chiến thắng B-52.", "text_kind": "normalized_summary"},
    {"key": "ev_museum_historical_focus", "source": "src_b52_military_museum_2026", "topic": "museum_historical_focus", "normalized_text": "Bảo tàng Chiến thắng B-52 lưu giữ, trưng bày và giới thiệu tư liệu, hiện vật về Chiến thắng Hà Nội - Điện Biên Phủ trên không năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_historical_event", "source": "src_b52_national_history", "topic": "historical_event", "normalized_text": "Chiến thắng Hà Nội - Điện Biên Phủ trên không diễn ra từ ngày 18 đến ngày 29 tháng 12 năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_pilots", "source": "src_b52_national_history", "topic": "involved_pilots", "normalized_text": "Trong chiến dịch tháng 12 năm 1972, phi công Phạm Tuân bắn rơi một máy bay B-52 trong đêm 27 tháng 12 và phi công Vũ Xuân Thiều bắn rơi một máy bay B-52 trong đêm 28 tháng 12.", "text_kind": "normalized_summary"}
