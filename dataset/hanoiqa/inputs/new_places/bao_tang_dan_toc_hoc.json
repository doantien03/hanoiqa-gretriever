    },
    {
      "key": "ev_category_management",
      "source": "src_vme_mission_2026",
      "topic": "category_and_management",
      "normalized_text": "Đây là bảo tàng chuyên nghiên cứu, sưu tầm, bảo quản, trưng bày, giáo dục và giới thiệu văn hóa các dân tộc; đơn vị trực thuộc Viện Hàn lâm Khoa học xã hội Việt Nam.",
      "text_kind": "normalized_summary"
    },
    {
