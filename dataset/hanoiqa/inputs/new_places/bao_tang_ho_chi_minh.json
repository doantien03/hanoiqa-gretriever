    {
      "key": "ev_current_address",
      "source": "src_museum_contact",
      "topic": "current_address",
      "normalized_text": "Bảo tàng có địa chỉ số 19 phố Ngọc Hà, Ba Đình, Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_current_ward",
      "source": "src_badinh_current",
      "topic": "current_administrative_area",
      "normalized_text": "Sau sắp xếp đơn vị hành chính năm 2025, Bảo tàng Hồ Chí Minh nằm trong địa bàn phường Ba Đình, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_category_mission",
      "source": "src_museum_mission",
      "topic": "category_and_mission",
      "normalized_text": "Đây là bảo tàng lưu niệm danh nhân, thực hiện nghiên cứu, lưu giữ, trưng bày và giáo dục về cuộc đời, sự nghiệp, tư tưởng, đạo đức và phong cách Hồ Chí Minh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_management",
      "source": "src_museum_history",
      "topic": "management",
      "normalized_text": "Từ ngày 10 tháng 5 năm 1990, bảo tàng trực thuộc cơ quan quản lý nhà nước về văn hóa ở trung ương, nay là Bộ Văn hóa, Thể thao và Du lịch.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_preparation_1970",
      "source": "src_museum_history",
      "topic": "preparation",
      "normalized_text": "Ban Phụ trách xây dựng Bảo tàng Hồ Chí Minh được thành lập ngày 25 tháng 11 năm 1970, mở đầu quá trình chuẩn bị kéo dài gần 20 năm.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_resolution_1977",
      "source": "src_museum_history",
      "topic": "institution_establishment",
      "normalized_text": "Ngày 12 tháng 9 năm 1977, Bộ Chính trị Ban Chấp hành Trung ương Đảng Cộng sản Việt Nam ban hành nghị quyết số 04-NQ/TW để thành lập Viện Bảo tàng Hồ Chí Minh và xác định mục đích tưởng niệm, học tập di sản của Người.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_decree_1979",
      "source": "src_museum_history",
      "topic": "government_decree",
      "normalized_text": "Ngày 15 tháng 10 năm 1979, Nghị định số 375/CP quy định chức năng, nhiệm vụ và tổ chức của Viện Bảo tàng Hồ Chí Minh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_groundbreaking_inauguration",
      "source": "src_museum_display",
      "topic": "construction_timeline",
      "normalized_text": "Công trình được khởi công ngày 31 tháng 8 năm 1985 và khánh thành ngày 19 tháng 5 năm 1990, đúng dịp kỷ niệm 100 năm ngày sinh Chủ tịch Hồ Chí Minh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_unesco_1987",
      "source": "src_museum_history",
      "topic": "unesco_resolution",
      "normalized_text": "Tháng 11 năm 1987, Nghị quyết 18.65 khuyến nghị các quốc gia thành viên tham gia kỷ niệm 100 năm ngày sinh Chủ tịch Hồ Chí Minh; quá trình hoàn thiện công trình sau đó hướng tới mốc 19 tháng 5 năm 1990.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_complex_area",
      "source": "src_government_area",
      "topic": "area_and_nearby_places",
      "normalized_text": "Bảo tàng có tổng diện tích 18.000 m² và nằm trong quần thể kết hợp với Lăng Chủ tịch Hồ Chí Minh, Khu Di tích Phủ Chủ tịch và Chùa Một Cột.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_architecture",
      "source": "src_hanoi_architecture",
      "topic": "building_architecture",
      "normalized_text": "Tòa nhà Bảo tàng Hồ Chí Minh là một hạng mục kiến trúc thuộc Bảo tàng Hồ Chí Minh. Công trình có dạng khối vuông vát góc, cao ba tầng và gần 20 m, mỗi chiều dài 70 m, đồng thời mang biểu tượng bông sen trắng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_front_relief",
      "source": "src_hanoi_architecture",
      "topic": "front_relief",
      "normalized_text": "Mặt trước tòa nhà có phù điêu lớn hình quốc kỳ và búa liềm đan quyện, đặt trên mảng hình vuông mỗi cạnh 8 m.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_opening_hall_statue",
      "source": "src_hanoi_architecture",
      "topic": "opening_hall_and_statue",
      "normalized_text": "Gian mở đầu cao hơn 9 m, rộng 360 m²; trung tâm đặt tượng đồng toàn thân Chủ tịch Hồ Chí Minh cao 3,5 m.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_three_exhibition_sections",
      "source": "src_museum_display",
      "topic": "exhibition_structure",
      "normalized_text": "Trưng bày gồm ba phần gắn bó: tiểu sử Chủ tịch Hồ Chí Minh, lịch sử đất nước và nhân dân Việt Nam, cùng các sự kiện chính của lịch sử thế giới ảnh hưởng tới hoạt động của Người và cách mạng Việt Nam.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_eight_halls",
      "source": "src_museum_display",
      "topic": "thematic_halls",
      "normalized_text": "Phần lịch sử thế giới gồm tám gian chuyên đề, tương ứng tám giảng đường nhỏ để mở rộng nghiên cứu về các biến cố lịch sử từ giữa thế kỷ XIX đến hiện tại.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_memorial_hall",
      "source": "src_museum_display",
      "topic": "memorial_hall",
      "normalized_text": "Gian tưởng niệm Chủ tịch Hồ Chí Minh là một tổ hợp không gian thuộc phần trưng bày về đất nước, cuộc sống, chiến đấu và thắng lợi của nhân dân Việt Nam.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_activities",
      "source": "src_museum_mission",
      "topic": "visitor_and_research_activities",
      "normalized_text": "Các hoạt động gồm tham quan trưng bày hiện vật, nghiên cứu và học tập tư tưởng, đạo đức Hồ Chí Minh.",
      "text_kind": "normalized_summary"
    }
