    {"key": "ev_mig_5121", "source": "src_official_treasures", "topic": "mig_21_5121", "normalized_text": "Máy bay MiG-21 số hiệu 5121 bắn hạ 5 máy bay Mỹ, trong đó Phạm Tuân bắn rơi một máy bay B-52 vào đêm 27 tháng 12 năm 1972.", "text_kind": "normalized_summary"},
    {"key": "ev_tank_843", "source": "src_official_treasures", "topic": "tank_843", "normalized_text": "Xe tăng T-54B số hiệu 843 tham gia chiến dịch năm 1975 và là một trong hai xe tăng đầu tiên tiến vào Dinh Độc Lập trưa 30 tháng 4 năm 1975.", "text_kind": "normalized_summary"},
