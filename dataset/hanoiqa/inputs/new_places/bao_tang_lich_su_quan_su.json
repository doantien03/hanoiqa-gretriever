    {"key": "ev_six_topics", "source": "src_qdnd_architecture", "topic": "six_display_topics", "normalized_text": "Hệ thống trưng bày trong nhà được tổ chức theo sáu chủ đề lịch sử, từ buổi đầu dựng nước đến xây dựng và bảo vệ đất nước hiện nay.", "text_kind": "normalized_summary"},
    {"key": "ev_topic_details", "source": "src_official_six_topics", "topic": "display_topic_sequence", "quote": "hệ thống trưng bày trong nhà được sắp xếp theo tiến trình lịch sử với 6 chủ đề", "normalized_text": "Sáu chủ đề lần lượt bao quát: buổi đầu dựng nước; bảo vệ độc lập; chống Pháp giành độc lập; kháng chiến chống Pháp; kháng chiến chống Mỹ; xây dựng và bảo vệ đất nước.", "text_kind": "normalized_summary"},
    {"key": "ev_collection_count", "source": "src_qdnd_collection", "topic": "collection_and_treasure_count", "quote": "lưu giữ hơn 150.000 hiện vật, trong đó có 4 bảo vật quốc gia", "normalized_text": "Kho sưu tập lưu giữ hơn 150.000 hiện vật, trong đó có 4 Bảo vật quốc gia và nhiều hiện vật quý.", "text_kind": "normalized_summary"},
    {"key": "ev_four_treasures", "source": "src_official_treasures", "topic": "four_national_treasures", "normalized_text": "Bốn hiện vật thuộc Bảo tàng Lịch sử Quân sự Việt Nam tiêu biểu mang danh hiệu Bảo vật quốc gia gồm hai máy bay MiG-21 số hiệu 4324 và 5121, xe tăng T-54B số hiệu 843 và Bản đồ Quyết tâm Chiến dịch Hồ Chí Minh.", "text_kind": "normalized_summary"},
