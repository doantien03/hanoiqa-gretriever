  "evidence": [
    {"key": "ev_identity_address", "source": "src_kimlien_chua_boc", "topic": "identity_and_current_address", "normalized_text": "Chùa có tên chữ Sùng Phúc tự hoặc Thiên Phúc tự và hiện tọa lạc tại số 25 phố Chùa Bộc, phường Kim Liên, thành phố Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_category_and_worship", "source": "src_kimlien_chua_boc", "topic": "category_and_worship", "normalized_text": "Công trình vốn được dựng để thờ Phật, đồng thời thờ Hoàng đế Quang Trung và tưởng niệm những quân Thanh tử trận tại chiến trường Đống Đa.", "text_kind": "normalized_summary"},
    {"key": "ev_1676_1686", "source": "src_kimlien_chua_boc", "topic": "renovation_1676_and_casting_1686", "normalized_text": "Chùa được tu sửa khang trang vào năm Vĩnh Trị nguyên niên 1676; đến năm Chính Hòa thứ bảy 1686 tiếp tục đúc tượng Phật và chuông đồng.", "text_kind": "normalized_summary"},
    {"key": "ev_1789_1792", "source": "src_cultural_heritage_go_dong_da", "topic": "battle_and_reconstruction", "normalized_text": "Chùa bị thiêu trụi trong trận Đống Đa năm 1789, được trùng tu trên nền cũ vào năm 1792, làm nơi quy y cho vong hồn quân Thanh và đổi tên thành Thiên Phúc tự.", "text_kind": "normalized_summary"},
    {"key": "ev_rebuilders", "source": "src_history_museum_quang_trung", "topic": "rebuilders_in_1792", "normalized_text": "Bia dựng tháng Giêng năm Nhâm Tý 1792 ghi việc Tăng thống Lê Đình Lượng, tự Đức Trường, cùng sắc mục Vũ Viết Hoa và nhân dân trại Khương Thượng phát tâm xây dựng lại chùa và làm lại tượng Phật.", "text_kind": "normalized_summary"},
    {"key": "ev_battle_landscape", "source": "src_cultural_heritage_go_dong_da", "topic": "battle_related_landscape", "normalized_text": "Hồ phía trước được gọi là Hồ Tắm Tượng, gắn với đội voi nghĩa quân Tây Sơn sau khi hạ đồn Khương Thượng; phía sau có Loa Sơn và trong chùa có Thanh Miếu thờ Sầm Nghi Đống cùng quân Thanh tử trận.", "text_kind": "normalized_summary"},
    {"key": "ev_architecture", "source": "src_kimlien_chua_boc", "topic": "architectural_components", "normalized_text": "Mặt bằng hiện có Tam Quan Ngoại, Hồ Tắm Tượng, Tam Quan Nội, Tiền Đường, Thượng Điện, hai dãy Hành Lang, Nhà Tổ, Nhà Khách, Vườn Tháp, Thanh Miếu và nhà trưng bày chiến thắng Đống Đa.", "text_kind": "normalized_summary"},
    {"key": "ev_main_buildings", "source": "src_kimlien_chua_boc", "topic": "main_building_layout", "normalized_text": "Chùa chính có dạng chữ Đinh gồm Tiền Đường chín gian hai dĩ và Thượng Điện ba gian dọc; Nhà Tổ cũng có dạng chữ Đinh gồm Tiền Tế và Hậu Cung.", "text_kind": "normalized_summary"},
    {"key": "ev_later_restorations", "source": "src_kimlien_chua_boc", "topic": "later_restorations", "normalized_text": "Tam Quan Nội được tôn tạo năm 1982; hai dãy Hành Lang được trùng tu trong giai đoạn 1997–1998 và hiện được sử dụng làm Nhà Khách.", "text_kind": "normalized_summary"},
    {"key": "ev_heritage_objects", "source": "src_kimlien_chua_boc", "topic": "statues_bell_and_steles", "normalized_text": "Di tích bảo lưu bộ tượng Tam Thế Phật bằng gỗ mít, bộ tượng Thích Ca cùng nhị vị Bồ Tát, tượng Đức Ông và hai thị giả, một chuông đồng, các hoành phi, câu đối và bia đá có niên đại 1676, 1686, 1792.", "text_kind": "normalized_summary"},
    {"key": "ev_quang_trung_statue", "source": "src_history_museum_statue", "topic": "quang_trung_statue", "normalized_text": "Tượng Đức Ông có kích thước gần như người thật, mặc hoàng bào, đội mũ xung thiên và ngồi cùng hai tượng thị giả; dòng khắc “Bính Ngọ tạo Quang Trung tượng” xác định tượng được tạc năm 1846 và được nhận định là tượng Hoàng đế Quang Trung.", "text_kind": "normalized_summary"},
    {"key": "ev_statue_discovery", "source": "src_history_museum_quang_trung", "topic": "statue_inscription_discovery", "normalized_text": "Ngày 22/4/1962, việc nghiên cứu phía sau bệ gỗ phát hiện dòng chữ “Bính Ngọ tạo Quang Trung tượng”, cung cấp căn cứ nhận diện pho tượng Đức Ông với Hoàng đế Quang Trung.", "text_kind": "normalized_summary"},
    {"key": "ev_festival", "source": "src_nhandan_festival", "topic": "annual_festival", "normalized_text": "Vào mùng 5 tháng Giêng, hoạt động tế lễ được tổ chức tại Chùa Bộc và Chùa Đồng Quang trước khi đoàn rước đến Gò Đống Đa để tưởng niệm Hoàng đế Quang Trung và chiến thắng mùa xuân năm 1789.", "text_kind": "normalized_summary"},
    {"key": "ev_prayer_activity", "source": "src_kimlien_chua_boc", "topic": "memorial_and_prayer_activity", "normalized_text": "Hằng năm vào mùng 5 Tết âm lịch, chùa làm lễ tưởng niệm Hoàng đế Quang Trung và cầu siêu cho vong linh quân Thanh tại Thanh Miếu.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking", "source": "src_kimlien_chua_boc", "topic": "national_historic_ranking", "normalized_text": "Chùa Bộc được công nhận là di tích lịch sử cấp quốc gia ngày 13/01/1964.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking_authority", "source": "src_legal_decision_1964", "topic": "ranking_authority_and_decision", "normalized_text": "Quyết định 29-VH-QĐ ngày 13/01/1964 do Bộ trưởng Bộ Văn hóa ban hành liệt hạng Chùa Bộc, khi đó thuộc xã Khương Thượng, khu Đống Đa.", "text_kind": "normalized_summary"},
    {"key": "ev_visitor_value", "source": "src_kimlien_chua_boc", "topic": "visitor_and_education_value", "normalized_text": "Di tích là nơi tham quan, điền dã, học tập ngoại khóa, tìm hiểu lịch sử và chiêm bái; các giá trị lịch sử, kiến trúc, cảnh quan, di vật và lễ hội tạo nên sức hấp dẫn của địa điểm.", "text_kind": "normalized_summary"}
  ],
