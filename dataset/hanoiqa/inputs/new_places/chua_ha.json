  "evidence": [
    {
      "key": "ev_address_current",
      "source": "src_caugiay_profile",
      "topic": "current_address",
      "normalized_text": "Địa chỉ được công bố là số 88 phố Chùa Hà; địa danh hiện thuộc phường Cầu Giấy, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_category_status",
      "source": "src_caugiay_profile",
      "topic": "classification",
      "normalized_text": "Chùa Hà là một ngôi chùa cổ; hồ sơ phân loại di tích gồm di tích nghệ thuật và di tích cách mạng kháng chiến.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_official_recognition",
      "source": "src_caugiay_profile",
      "topic": "heritage_recognition",
      "normalized_text": "Di tích được xếp hạng ở cấp Bộ Văn hóa và Thông tin, ghi năm xếp hạng 1996 và Quyết định số 310/QĐ-BT ngày 13/02/1995.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_name_complex",
      "source": "src_sovhtt_2025",
      "topic": "name_and_complex",
      "normalized_text": "Chùa có tên tự là Thánh Đức Tự và cùng Đình Bối Hà tạo thành cụm di tích Đình – Chùa Hà.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_activity",
      "source": "src_sovhtt_2025",
      "topic": "visitor_activity",
      "normalized_text": "Người dân và du khách đến hành lễ, đặc biệt đông vào dịp đầu xuân và Rằm tháng Giêng; địa điểm nổi tiếng với tập tục cầu tình duyên.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_management",
      "source": "src_sovhtt_2024",
      "topic": "management",
      "normalized_text": "Tiểu ban quản lý di tích thực hiện chỉnh trang cảnh quan, vệ sinh khuôn viên và các khu vực hành lễ; di tích được giới thiệu bằng mã QR.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_legend_ly",
      "source": "src_world_heritage",
      "topic": "ly_dynasty_tradition",
      "normalized_text": "Theo truyền thuyết, Lý Thánh Tông ghé chùa và ban tiền trùng tu sau việc cầu tự dẫn tới sự ra đời của Thái tử Càn Đức, sau là Lý Nhân Tông; tên Thánh Đức tự gắn với câu chuyện này.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_legend_le",
      "source": "src_world_heritage",
      "topic": "le_dynasty_tradition",
      "normalized_text": "Một truyền thuyết khác gắn việc dựng chùa với Lê Thánh Tông và sự kiện nhà vua lên ngôi năm 1460.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_1680",
      "source": "src_world_heritage",
      "topic": "renovation",
      "normalized_text": "Dưới đời Lê Hy Tông, hai gia đình quê Thổ Hà cùng dân trong xóm góp tiền xây dựng lại chùa quy mô lớn bằng gạch và ngói vào năm Chính Hòa 1680.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_tam_quan",
      "source": "src_world_heritage",
      "topic": "tam_quan_architecture",
      "normalized_text": "Tam quan được xây hai tầng; tầng trên theo kiểu chồng diêm và treo chuông đồng Thánh Đức tự chung.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_bell",
      "source": "src_world_heritage",
      "topic": "bell",
      "normalized_text": "Chuông đồng Thánh Đức tự chung mang niên hiệu Cảnh Thịnh thứ 7, tương ứng năm 1799, là di vật thời Tây Sơn còn được bảo quản.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_steles",
      "source": "src_world_heritage",
      "topic": "steles",
      "normalized_text": "Bên hồ có bia đá bốn mặt Thánh Đức tự bi tạo năm Chính Hòa thứ 16, tức năm 1695; phía trước chùa có nhóm bia hậu tạo vào cuối thời Nguyễn.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_stele_count",
      "source": "src_world_heritage",
      "topic": "rear_stele_count",
      "normalized_text": "Nhóm bia hậu ở bên phải phía trước cửa chùa gồm chính xác 18 tấm, ghi việc tu sửa và gửi hậu tại chùa.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_main_architecture",
      "source": "src_ldtd_2020",
      "topic": "main_architecture",
      "normalized_text": "Chùa chính kết cấu kiểu chữ Đinh, gồm Tiền đường và Thượng điện; Tam bảo có năm gian rộng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_mother_palace",
      "source": "src_ldtd_2020",
      "topic": "mother_goddess_hall",
      "normalized_text": "Phía sau chính điện là Điện Mẫu; tại đây người đi lễ Mẫu cầu mong nhân duyên tốt đẹp.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_revolutionary_status",
      "source": "src_world_heritage",
      "topic": "revolutionary_status",
      "normalized_text": "Năm 1982, chùa được gắn biển Di tích cách mạng; tháng 12 năm 1996, chùa được xếp hạng bảo tồn.",
      "text_kind": "normalized_summary"
    }
  ],
