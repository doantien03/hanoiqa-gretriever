  "evidence": [
    {"key": "ev_current_admin", "source": "src_huongson_current_admin", "topic": "current_administrative_unit", "normalized_text": "Cổng thông tin chính quyền địa phương xác nhận xã Hương Sơn hiện hành của thành phố Hà Nội được hình thành sau sắp xếp đơn vị hành chính năm 2025 và là địa bàn gắn với khu danh thắng Chùa Hương.", "text_kind": "normalized_summary"},
    {"key": "ev_distribution_address", "source": "src_government_distribution", "topic": "complex_distribution_address_and_local_management", "normalized_text": "Báo Điện tử Chính phủ xác định quần thể danh thắng Hương Sơn gồm 21 đền, chùa, hang động phân bố tại bốn thôn Yến Vỹ, Đục Khê, Hội Xá và Phú Yên, thuộc xã Hương Sơn; bài viết dẫn thông tin quản lý lễ hội từ Trưởng Ban Quản lý Di tích và thắng cảnh Hương Sơn. Phạm vi bốn thôn được chuẩn hóa thành một địa chỉ duy nhất cho toàn quần thể.", "text_kind": "normalized_summary"},
    {"key": "ev_natural_setting", "source": "src_government_ranking", "topic": "natural_setting", "normalized_text": "Danh thắng Hương Sơn thuộc xã Hương Sơn, có hệ thống núi đá vôi và hang động được kết nối bởi Suối Yến; động Hương Tích là điểm nổi tiếng nhất của quần thể.", "text_kind": "normalized_summary"},
    {"key": "ev_categories_values", "source": "src_government_planning", "topic": "heritage_categories_and_values", "normalized_text": "Nhiệm vụ quy hoạch của Chính phủ xác định Chùa Hương là di tích lịch sử và danh lam thắng cảnh có giá trị văn hóa, tín ngưỡng, kiến trúc, cảnh quan và đa dạng sinh học.", "text_kind": "normalized_summary"},
    {"key": "ev_religious_character", "source": "src_government_ranking", "topic": "religious_character", "normalized_text": "Báo Điện tử Chính phủ mô tả Hương Sơn là quần thể văn hóa - tôn giáo, gồm các chùa thờ Phật và đền thờ thần theo tín ngưỡng nông nghiệp bản địa, gắn chặt với Phật giáo.", "text_kind": "normalized_summary"},
    {"key": "ev_origin", "source": "src_history_museum_origin", "topic": "origin_under_le_thanh_tong", "normalized_text": "Bảo tàng Lịch sử Quốc gia cho biết ba vị hòa thượng tìm ra động Hương Tích và dựng thảo am Thiên Trù dưới thời vua Lê Thánh Tông (1442–1497), tạo nền tảng cho quá trình gây dựng Hương Sơn.", "text_kind": "normalized_summary"},
    {"key": "ev_revival", "source": "src_history_museum_origin", "topic": "revival_in_late_17th_century", "normalized_text": "Vào nửa cuối thế kỷ XVII, thời Lê Trung Hưng, Hòa thượng Trần Đạo Viên Quang Chân nhân chấn hưng cõi Phật Hương Sơn.", "text_kind": "normalized_summary"},
    {"key": "ev_huong_thien_components", "source": "src_government_distribution", "topic": "main_route_components", "normalized_text": "Tuyến trung tâm Hương Tích được nguồn Chính phủ mô tả qua Suối Yến và các điểm đền Trình Ngũ Nhạc, chùa Thiên Trù, động Tiên Sơn, chùa Giải Oan, đền Cửa Võng, động Hương Tích, động Hinh Bồng và động Đại Binh.", "text_kind": "normalized_summary"},
    {"key": "ev_other_route_components", "source": "src_huong_tich_components", "topic": "long_van_and_tuyet_son_components", "normalized_text": "Trang thông tin chính thức Chùa Hương liệt kê tuyến Long Vân có chùa Long Vân và động Long Vân; tuyến Tuyết Sơn có chùa Bảo Đài, động Ngọc Long, chùa Ngư Trì và đền Trình Phú Yên.", "text_kind": "normalized_summary"},
    {"key": "ev_quan_the_am", "source": "src_government_ranking", "topic": "quan_the_am_tradition", "normalized_text": "Nguồn Chính phủ ghi nhận quần thể Hương Sơn gắn với Bồ Tát Quán Thế Âm, thường gọi Bà Chúa Ba, và động Hương Tích là trung tâm nổi tiếng của quần thể.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking", "source": "src_cultural_heritage_decision", "topic": "national_special_ranking", "normalized_text": "Cục Di sản văn hóa xác nhận Quyết định 2082/QĐ-TTg ngày 25/12/2017 của Thủ tướng Chính phủ xếp hạng Di tích lịch sử và danh lam thắng cảnh Quần thể Hương Sơn (Chùa Hương) là di tích quốc gia đặc biệt.", "text_kind": "normalized_summary"},
    {"key": "ev_management", "source": "src_government_planning", "topic": "management_responsibility", "normalized_text": "Theo nhiệm vụ quy hoạch được Chính phủ phê duyệt, Ủy ban nhân dân thành phố Hà Nội là cơ quan tổ chức lập quy hoạch tu bổ, phục hồi và phát huy giá trị Di tích Chùa Hương.", "text_kind": "normalized_summary"},
    {"key": "ev_tourism_activities", "source": "src_hanoi_tourism_values", "topic": "tourism_and_pilgrimage_activities", "normalized_text": "Sở Văn hóa và Thể thao Hà Nội mô tả Suối Yến, động Hương Tích, động Tiên Sơn, suối Giải Oan cùng đền Trình, chùa Thiên Trù và đền Cửa Võng; nơi đây đón đông du khách hành hương, chiêm bái và tham gia hoạt động tín ngưỡng, tôn giáo.", "text_kind": "normalized_summary"},
    {"key": "ev_festival_2026", "source": "src_government_festival_2026", "topic": "festival_2026_schedule_and_program", "normalized_text": "Lễ hội Du lịch Chùa Hương năm 2026 diễn ra từ 18/2 đến 11/5/2026, tương ứng mùng 2 tháng Giêng đến 25 tháng Ba năm Bính Ngọ; chương trình có nghi lễ tại Thiên Trù, Hương Tích và các hoạt động văn hóa, nghệ thuật, dân gian.", "text_kind": "normalized_summary"},
    {"key": "ev_ho_chi_minh_visit", "source": "src_history_museum_ho_chi_minh", "topic": "ho_chi_minh_visit_1958", "normalized_text": "Bảo tàng Lịch sử Quốc gia ghi nhận sáng 19/5/1958, Chủ tịch Hồ Chí Minh thăm thắng cảnh Hương Sơn, đến Thiên Trù, Chấn Song - Cửa Võng, Giải Oan và Hương Tích, đồng thời căn dặn giữ gìn, tu sửa di tích.", "text_kind": "normalized_summary"}
  ],
