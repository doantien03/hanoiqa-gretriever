  "evidence": [
    {"key": "ev_identity_address", "source": "src_lang_current_overview", "topic": "identity_and_current_address", "normalized_text": "Chùa có tên chữ Chiêu Thiền tự, còn gọi là Chùa Cả, và hiện tọa lạc tại số 116 phố Chùa Láng, phường Láng, thành phố Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_origin_worship", "source": "src_lang_current_overview", "topic": "origin_and_worship", "normalized_text": "Chùa được xây dựng dưới thời vua Lý Anh Tông (1138–1175), ngoài thờ Phật còn thờ Thiền sư Từ Đạo Hạnh và vua Lý Thần Tông.", "text_kind": "normalized_summary"},
    {"key": "ev_area_scale", "source": "src_hanoi_heritage_2022", "topic": "area_and_scale", "normalized_text": "Khuôn viên chùa có diện tích 17.917 m² và quy mô gồm 100 gian lớn nhỏ.", "text_kind": "normalized_summary"},
    {"key": "ev_renovations", "source": "src_lang_current_overview", "topic": "historical_renovations", "normalized_text": "Chùa được sửa chữa nhiều lần vào các năm Thịnh Đức thứ tư 1656, Cảnh Trị thứ tư 1666, Tự Đức thứ 22 năm 1869 và Thành Thái thứ 13 năm 1901.", "text_kind": "normalized_summary"},
    {"key": "ev_layout", "source": "src_lang_current_overview", "topic": "architectural_layout", "normalized_text": "Các công trình được bố cục trên trục chính đạo, qua ba lớp cổng và sân gạch; giữa sân có Nhà Bát Giác, hai bên là Dải Vũ, còn chùa chính theo kiểu nội công ngoại quốc gồm Tiền Đường, Phương Đình, Trung Đường, Thiêu Hương và Thượng Điện.", "text_kind": "normalized_summary"},
    {"key": "ev_support_buildings", "source": "src_lang_current_overview", "topic": "supporting_buildings", "normalized_text": "Hai bên Thượng Điện có Hành Lang; phía sau có Nhà Chuông, Nhà Khánh, khu thờ Mẫu, thờ Tổ, Tả - Hữu Mạc và Vườn Tháp.", "text_kind": "normalized_summary"},
    {"key": "ev_gate_architecture", "source": "src_hanoi_heritage_2022", "topic": "gate_architecture", "normalized_text": "Tam Quan mang dáng dấp nghi môn cung vua phủ chúa thời Lê Trung Hưng, gồm bốn cột vuông và ba mái nhỏ uốn cong; phía dưới có đôi voi phục.", "text_kind": "normalized_summary"},
    {"key": "ev_octagonal_house", "source": "src_hanoi_heritage_2022", "topic": "octagonal_house", "normalized_text": "Nhà Bát Giác, còn gọi Nhà Bảo Cái, nằm giữa sân, dùng đặt kiệu Thánh trước ngày hội và có kết cấu chồng diêm hai tầng, 16 mái.", "text_kind": "normalized_summary"},
    {"key": "ev_objects", "source": "src_hanoi_heritage_2022", "topic": "heritage_objects", "normalized_text": "Chùa lưu giữ Án Văn chạm rồng thế kỷ XVII, hai cỗ kiệu rước thế kỷ XVIII và bộ sưu tập 198 pho tượng, trong đó 39 pho thuộc thời Lê Trung Hưng, số còn lại mang phong cách thời Nguyễn.", "text_kind": "normalized_summary"},
    {"key": "ev_sac_phong", "source": "src_lang_current_overview", "topic": "royal_decrees_and_stele", "normalized_text": "Các di vật gồm sắc phong cho Thiền sư Từ Đạo Hạnh và vua Lý Thần Tông thuộc các thời Hậu Lê, Tây Sơn, Nguyễn, cùng bia Chiêu Thiền tự tạo lệ bi ghi chép lịch sử và lệ tục của chùa.", "text_kind": "normalized_summary"},
    {"key": "ev_saint_statues", "source": "src_hanoi_heritage_2022", "topic": "saint_statues", "normalized_text": "Hậu cung đặt tượng vua Lý Thần Tông bằng gỗ mít và tượng Thiền sư Từ Đạo Hạnh đan bằng mây phủ sơn.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking", "source": "src_hanoi_festival_2024", "topic": "national_ranking", "normalized_text": "Chùa được xếp hạng di tích lịch sử, kiến trúc nghệ thuật cấp quốc gia vào năm 1962.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking_date", "source": "src_lang_current_overview", "topic": "national_ranking_date", "normalized_text": "Ngày xếp hạng di tích cấp quốc gia của Chùa Láng là 28/4/1962.", "text_kind": "normalized_summary"},
    {"key": "ev_festival_schedule", "source": "src_hanoi_festival_2024", "topic": "festival_schedule_and_rituals", "normalized_text": "Lễ hội tổ chức vào ngày mùng 7 tháng Ba âm lịch để tưởng nhớ Thiền sư Từ Đạo Hạnh và vua Lý Thần Tông; các nghi thức gồm dâng hương, lễ vật, bao sái, xuất cung và rước kiệu Thánh.", "text_kind": "normalized_summary"},
    {"key": "ev_festival_activities", "source": "src_hanoi_heritage_2022", "topic": "festival_activities", "normalized_text": "Ngoài tế lễ và rước Thánh, lễ hội có các trò đấu võ, chọi gà, cờ người, đập niêu và thổi cơm thi quanh Nhà Bát Giác.", "text_kind": "normalized_summary"},
    {"key": "ev_current_festival", "source": "src_lang_festival_2026", "topic": "current_festival_practice", "normalized_text": "Lễ hội năm 2026 diễn ra trong ba ngày với các nghi thức dâng lễ, rước, tế, dâng hương cùng hoạt động văn nghệ, trò chơi dân gian và sinh hoạt cộng đồng.", "text_kind": "normalized_summary"},
    {"key": "ev_opening_2026", "source": "src_lang_opening_2026", "topic": "festival_opening_2026", "normalized_text": "Ngày chính hội năm 2026 khai mạc sáng 23/4, tức mùng 7 tháng Ba âm lịch, với sự tham dự của người dân địa phương và du khách.", "text_kind": "normalized_summary"},
    {"key": "ev_saint_memorial", "source": "src_lang_saint_memorial_2025", "topic": "saint_memorial", "normalized_text": "Lễ kỵ Đức Thánh Láng được duy trì hằng năm để tưởng niệm ngày hóa và tri ân công đức của Thiền sư Từ Đạo Hạnh.", "text_kind": "normalized_summary"},
    {"key": "ev_visitor_value", "source": "src_lang_current_overview", "topic": "visitor_and_research_value", "normalized_text": "Chùa là nơi nghiên cứu lịch sử Phật giáo, kiến trúc, điêu khắc và mỹ thuật, đồng thời thể hiện sự dung hòa giữa tín ngưỡng bản địa với Phật giáo.", "text_kind": "normalized_summary"}
  ],
