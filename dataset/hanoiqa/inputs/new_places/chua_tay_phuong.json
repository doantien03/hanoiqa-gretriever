  "evidence": [
    {"key": "ev_current_commune", "source": "src_tayphuong_current", "topic": "current_administrative_area", "normalized_text": "Cổng thông tin xã Tây Phương xác nhận Chùa Tây Phương hiện thuộc xã Tây Phương, thành phố Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_thon_yen", "source": "src_history_museum_statues", "topic": "village_location", "normalized_text": "Bảo tàng Lịch sử Quốc gia xác định Chùa Tây Phương nằm trên núi Tây Phương ở thôn Yên; tại thời điểm bài viết, đơn vị hành chính được ghi là xã Thạch Xá, huyện Thạch Thất, Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_names_location", "source": "src_dsvh_monument", "topic": "names_and_location", "normalized_text": "Chùa Tây Phương còn có tên Sùng Phúc tự và Chùa Tây, tọa lạc trên núi Câu Lậu; địa giới cũ được nguồn ghi là xã Thạch Xá, huyện Thạch Thất, Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_history_1554", "source": "src_dsvh_monument", "topic": "construction_history_1554", "normalized_text": "Theo các nhà nghiên cứu được Cục Di sản văn hóa dẫn lại, năm Giáp Dần 1554, đời Mạc Phúc Nguyên, Chùa Tây Phương đã được làm với quy mô cơ bản như ngày nay.", "text_kind": "normalized_summary"},
    {"key": "ev_renovation_1660", "source": "src_dsvh_monument", "topic": "renovation_1660", "normalized_text": "Năm Canh Tý 1660, chúa Trịnh Tạc cho tu sửa Chùa Tây Phương và làm Tam quan.", "text_kind": "normalized_summary"},
    {"key": "ev_components", "source": "src_dsvh_monument", "topic": "architectural_components", "normalized_text": "Quần thể gồm Tam quan hạ, Tam quan thượng, Miếu Sơn thần, ba tòa Tiền đường - Trung đường - Thượng điện, Nhà Tổ - Nhà Mẫu và Nhà khách.", "text_kind": "normalized_summary"},
    {"key": "ev_stairs", "source": "src_history_museum_architecture", "topic": "laterite_stairs", "normalized_text": "Bài giới thiệu kiến trúc năm 2017 của Bảo tàng Lịch sử Quốc gia ghi đường từ Tam quan hạ lên Tam quan thượng gồm 247 bậc đá ong; hồ sơ chỉ chuẩn hóa hạng mục là đường bậc đá ong vì một bài khác của cùng bảo tàng ghi số bậc khác.", "text_kind": "normalized_summary"},
    {"key": "ev_architecture", "source": "src_dsvh_monument", "topic": "architectural_style", "normalized_text": "Ba tòa chùa chính có khung gỗ, bố cục chữ Công, kết cấu chồng diêm hai tầng tám mái theo kiểu tàu đao lá mái; mái lợp ngói mũi hài và trang trí chạm khắc truyền thống.", "text_kind": "normalized_summary"},
    {"key": "ev_statues", "source": "src_history_museum_statues", "topic": "statue_collection", "normalized_text": "Chùa có hơn 70 tượng và phù điêu, chủ yếu bằng gỗ mít sơn son thếp vàng; tiêu biểu có Tam Thế Phật, Tuyết Sơn, 18 vị La Hán và tám pho Kim Cương - Hộ Pháp, phần lớn mang niên đại cuối thế kỷ XVIII.", "text_kind": "normalized_summary"},
    {"key": "ev_national_treasure", "source": "src_hanoi_festival_2025", "topic": "national_treasure_recognition", "normalized_text": "Cổng thông tin Hà Nội xác nhận 34 pho tượng Phật Chùa Tây Phương được công nhận là Bảo vật quốc gia năm 2015.", "text_kind": "normalized_summary"},
    {"key": "ev_tay_son_statues", "source": "src_sovhtt_festival_2026", "topic": "tay_son_statues", "normalized_text": "Sở Văn hóa và Thể thao Hà Nội xác định bộ tượng Phật Chùa Tây Phương thuộc thời Tây Sơn, có niên đại cuối thế kỷ XVIII, nổi bật với 18 vị La Hán và đã được công nhận là Bảo vật quốc gia.", "text_kind": "normalized_summary"},
    {"key": "ev_special_ranking", "source": "src_dsvh_monument", "topic": "national_special_ranking", "normalized_text": "Chùa Tây Phương được Thủ tướng Chính phủ xếp hạng Di tích quốc gia đặc biệt theo Quyết định 2408/QĐ-TTg ngày 31/12/2014.", "text_kind": "normalized_summary"},
    {"key": "ev_festival", "source": "src_history_museum_architecture", "topic": "festival_time_and_activities", "normalized_text": "Lễ hội Chùa Tây Phương lấy ngày mùng 6 tháng Ba âm lịch làm chính hội, có nghi thức cúng Phật, mộc dục, chạy đàn, tụng kinh cùng các hoạt động kéo co, đánh cờ, vật, chọi gà, rối nước và hát xứ Đoài.", "text_kind": "normalized_summary"},
    {"key": "ev_categories", "source": "src_government_planning", "topic": "heritage_and_tourism_function", "normalized_text": "Quy hoạch của Chính phủ xác định Chùa Tây Phương là di tích kiến trúc nghệ thuật quốc gia đặc biệt, trung tâm sinh hoạt văn hóa - tín ngưỡng và điểm du lịch hấp dẫn của Hà Nội cùng vùng đồng bằng sông Hồng.", "text_kind": "normalized_summary"}
  ],
