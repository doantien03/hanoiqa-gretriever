  "evidence": [
    {"key": "ev_current_address", "source": "src_quocoai_current_address", "topic": "current_address", "normalized_text": "Chùa Thầy nằm tại thôn Thụy Khuê, xã Quốc Oai, thành phố Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_names_origin", "source": "src_history_museum_overview", "topic": "names_origin_location", "normalized_text": "Chùa Thầy còn được gọi là Chùa Sài, Chùa Cả và Thiên Phúc tự; chùa khởi dựng dưới thời vua Lý Nhân Tông, gắn với Thiền sư Từ Đạo Hạnh và nằm dưới chân núi Sài Sơn ở Quốc Oai, Hà Nội.", "text_kind": "normalized_summary"},
    {"key": "ev_lake_pavilion", "source": "src_history_museum_overview", "topic": "lake_and_water_pavilion", "normalized_text": "Trước cửa chùa là hồ Long Trì; Thủy đình hình vuông nổi trên hồ, có móng đá ong, nền lát gạch Bát Tràng, kiến trúc chồng diêm tám mái và về sau dùng làm nơi diễn rối nước trong lễ hội.", "text_kind": "normalized_summary"},
    {"key": "ev_bridges", "source": "src_history_museum_overview", "topic": "bridges", "normalized_text": "Nhật Tiên kiều và Nguyệt Tiên kiều nằm hai bên phía trước Tiền Đường; cầu được dựng năm 1602 do Phùng Khắc Khoan tiến cúng, có móng đá ong, ba vòm cuốn và sàn lát gạch Bát Tràng.", "text_kind": "normalized_summary"},
    {"key": "ev_main_buildings", "source": "src_quocoai_architecture", "topic": "main_architecture", "normalized_text": "Phần chính Chùa Thầy bố cục chữ Tam gồm Chùa Hạ (Tiền tế), Chùa Trung (Điện Phật) và Chùa Thượng (Điện Thánh), kèm hai dãy hành lang, gác chuông và gác trống; tổng thể tiêu biểu cho lối thờ tự tiền Phật hậu Thánh.", "text_kind": "normalized_summary"},
    {"key": "ev_tam_phu", "source": "src_history_museum_overview", "topic": "tam_phu_temple", "normalized_text": "Đền Tam Phủ nằm trên gò đất nổi ở phía đông cầu Nhật Tiên, giữa không gian hồ trước Chùa Thầy.", "text_kind": "normalized_summary"},
    {"key": "ev_mountain_complex", "source": "src_history_museum_festival", "topic": "mountain_complex", "normalized_text": "Quần thể có Chùa Cao, còn gọi Đỉnh Sơn Tự hoặc Hiển Thụy Am, ở lưng chừng núi; phía sau có đường dẫn đến Thần Quang động, thường gọi là hang Cắc Cớ.", "text_kind": "normalized_summary"},
    {"key": "ev_honored_people", "source": "src_history_museum_festival", "topic": "honored_people", "normalized_text": "Điện Thánh thờ tượng ba kiếp của Thiền sư Từ Đạo Hạnh; hệ thống thờ tự còn có tượng vua Lý Thần Tông, phản ánh mối liên hệ đặc biệt của chùa với hai nhân vật này.", "text_kind": "normalized_summary"},
    {"key": "ev_objects", "source": "src_history_museum_overview", "topic": "heritage_objects", "normalized_text": "Chùa bảo lưu 36 pho tượng cổ từ thời Lý đến Nguyễn, bảy bia đá, 26 đạo sắc phong và lưng ngai gỗ thời Trần; các nhóm hiện vật này tạo nên bộ sưu tập di sản nhiều thời đại.", "text_kind": "normalized_summary"},
    {"key": "ev_festival", "source": "src_history_museum_festival", "topic": "festival", "normalized_text": "Lễ hội Chùa Thầy thường diễn ra từ mùng 3 đến mùng 7 tháng Ba âm lịch, gồm các nghi lễ như tắm tượng, cúng Phật, chạy đàn và hoạt động biểu diễn múa rối nước tại Thủy đình.", "text_kind": "normalized_summary"},
    {"key": "ev_ranking", "source": "src_government_ranking", "topic": "national_special_ranking", "normalized_text": "Quần thể Chùa Thầy và khu vực núi đá Sài Sơn, Hoàng Xá, Phượng Cách được xếp hạng Di tích quốc gia đặc biệt theo Quyết định 2408/QĐ-TTg ngày 31/12/2014 của Thủ tướng Chính phủ và được giao chính quyền Quốc Oai quản lý theo phân cấp.", "text_kind": "normalized_summary"},
    {"key": "ev_categories_values", "source": "src_government_planning", "topic": "heritage_categories_and_values", "normalized_text": "Quy hoạch của Chính phủ xác định Chùa Thầy và vùng núi đá liên quan là di tích lịch sử và danh lam thắng cảnh quốc gia đặc biệt, đồng thời là điểm tham quan du lịch của Hà Nội và đồng bằng sông Hồng.", "text_kind": "normalized_summary"},
    {"key": "ev_religious_category", "source": "src_history_museum_festival", "topic": "religious_category", "normalized_text": "Nguồn Bảo tàng Lịch sử Quốc gia giới thiệu Chùa Thầy là di tích kiến trúc Phật giáo và mô tả hệ thống thờ Phật cùng các nghi lễ Phật giáo tại chùa.", "text_kind": "normalized_summary"}
  ],
