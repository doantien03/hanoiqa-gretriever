  "evidence": [
    {
      "key": "ev_address",
      "source": "src_badinh_botanical_garden",
      "topic": "main_entrance_address",
      "normalized_text": "Công viên Bách Thảo có cổng chính tại số 3 phố Hoàng Hoa Thám, phường Ba Đình, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_establishment_1890",
      "source": "src_travelhanoi_history",
      "topic": "establishment_and_historical_layer",
      "normalized_text": "Chính quyền thực dân Pháp tại Hà Nội xây dựng và thành lập Vườn Bách Thảo vào năm 1890; nguồn gốc này gắn Công viên Bách Thảo với thời kỳ Pháp thuộc.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_current_area",
      "source": "src_badinh_botanical_garden",
      "topic": "current_area",
      "normalized_text": "Sau khi bị thu hẹp để nhường đất xây dựng Khu di tích lịch sử Ba Đình, Công viên Bách Thảo hiện có diện tích hơn 10 hecta.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_categories",
      "source": "src_badinh_botanical_garden",
      "topic": "park_categories",
      "normalized_text": "Công viên Bách Thảo là một vườn thực vật, đồng thời là công viên đô thị và không gian xanh công cộng của Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_landscape_components",
      "source": "src_badinh_botanical_garden",
      "topic": "landscape_components",
      "normalized_text": "Các hạng mục cảnh quan của Công viên Bách Thảo gồm Hồ Vị Danh và hệ thống đường đi bộ; trong hồ Vị Danh có một cây cầu phục vụ việc đi dạo và tham quan.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_botanical_collections",
      "source": "src_travelhanoi_history",
      "topic": "botanical_collections",
      "normalized_text": "Khu sưu tập thực vật của Công viên Bách Thảo gồm bộ sưu tập các loài cây bản địa quý hiếm từ nhiều vùng Việt Nam và bộ sưu tập các loài cây nhập nội từ nhiều châu lục.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_visitor_activities",
      "source": "src_badinh_botanical_garden",
      "topic": "visitor_activities_and_facilities",
      "normalized_text": "Công viên Bách Thảo có khu vui chơi trẻ em và phục vụ các hoạt động đi bộ, chạy bộ, tập thể dục thể thao, vui chơi dành cho trẻ em, tham quan và tìm hiểu các loài thực vật.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_peacock_and_management",
      "source": "src_vov_management",
      "topic": "peacock_enclosure_and_management",
      "normalized_text": "Công viên Bách Thảo có khu nuôi chim công và do Xí nghiệp Quản lý công viên cây xanh số 3 thuộc Công ty trách nhiệm hữu hạn một thành viên Công viên cây xanh Hà Nội quản lý.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_sculpture_and_bridge",
      "source": "src_skds_sculpture_garden",
      "topic": "sculpture_garden_round_island_bridge",
      "normalized_text": "Vườn tượng nghệ thuật là một hạng mục trong Công viên Bách Thảo; công viên còn có đảo tròn trong hồ và cầu nối từ bờ ra đảo tròn.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_nui_sua_temple",
      "source": "src_badinh_nui_sua_temple",
      "topic": "nui_sua_temple_history_and_worship",
      "normalized_text": "Đền Núi Sưa nằm trên đỉnh Núi Sưa trong khuôn viên Công viên Bách Thảo, thờ Huyền Thiên Hắc Đế; thần tích của đền gắn với vua Lý Thánh Tông và triều Lý, còn hoạt động tín ngưỡng tại đền gồm dâng hương tưởng niệm vị thần.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_nui_sua_architecture",
