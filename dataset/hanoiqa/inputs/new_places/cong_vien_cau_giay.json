      "normalized_text": "Quảng trường trung tâm Công viên Cầu Giấy được cải tạo bằng bê tông đá mài và phủ lớp sơn tăng cứng chống rêu mốc.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_gate_material",
      "source": "src_vtv_renovation_2025",
      "topic": "main_gate_material",
      "normalized_text": "Cổng chính Công viên Cầu Giấy được xây mới trụ và sử dụng đá ốp cho các trụ cổng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_children_area_use",
      "source": "src_vnexpress_after_renovation",
