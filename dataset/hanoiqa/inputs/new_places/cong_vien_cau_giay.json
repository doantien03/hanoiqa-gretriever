    },
    {
      "key": "ev_project_measurements",
      "source": "src_vtv_renovation_2025",
      "topic": "renovation_project_measurements",
      "normalized_text": "Phạm vi dự án cải tạo Công viên Cầu Giấy có diện tích 95.282 mét vuông, trong đó hồ nước Công viên Cầu Giấy có diện tích 14.808 mét vuông.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_categories",
      "source": "src_signboard_2025",
      "topic": "park_categories",
      "normalized_text": "Công viên Cầu Giấy là công viên công cộng và không gian xanh đô thị phục vụ hoạt động vui chơi, thể thao và sinh hoạt cộng đồng của người dân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_primary_components",
      "source": "src_vtv_renovation_2025",
      "topic": "primary_functional_components",
      "normalized_text": "Các không gian chức năng chính của Công viên Cầu Giấy gồm Khu vui chơi trẻ em Công viên Cầu Giấy, Khu thể dục thể thao Công viên Cầu Giấy, Hồ nước Công viên Cầu Giấy và Quảng trường trung tâm Công viên Cầu Giấy.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_supporting_components",
      "source": "src_signboard_2025",
      "topic": "supporting_components",
      "normalized_text": "Các hạng mục phụ trợ của Công viên Cầu Giấy gồm Hệ thống đường giao thông nội bộ Công viên Cầu Giấy, Nhà chòi nghỉ Công viên Cầu Giấy, Nhà điều hành Công viên Cầu Giấy và Nhà vệ sinh công cộng Công viên Cầu Giấy.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_entrance_components",
      "source": "src_vnexpress_after_renovation",
      "topic": "main_entrance_components",
      "normalized_text": "Khu vực lối vào trên phố Thành Thái của Công viên Cầu Giấy gồm Cổng chính Công viên Cầu Giấy và Đài phun nước nghệ thuật Công viên Cầu Giấy.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_square_material",
      "source": "src_vtv_renovation_2025",
