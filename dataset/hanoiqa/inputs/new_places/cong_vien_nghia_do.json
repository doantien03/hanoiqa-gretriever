  "evidence": [
    {
      "key": "ev_address_and_area",
      "source": "src_tienphong_bridge",
      "topic": "address_and_area",
      "normalized_text": "Công viên Nghĩa Đô nằm tại đường Nguyễn Văn Huyên, phường Nghĩa Đô, thành phố Hà Nội, với diện tích hơn 42.000 mét vuông.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_initial_construction",
      "source": "src_vntrip_history",
      "topic": "initial_construction",
      "normalized_text": "Dự án xây dựng Công viên Nghĩa Đô được phê duyệt và bắt đầu triển khai xây dựng vào năm 2002.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_categories",
      "source": "src_government_inauguration",
      "topic": "park_categories",
      "normalized_text": "Công viên Nghĩa Đô là một công viên đô thị và không gian xanh công cộng phục vụ cộng đồng dân cư phường Nghĩa Đô và thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_landscape_components",
      "source": "src_skds_renovated_components",
      "topic": "landscape_and_activity_components",
      "normalized_text": "Các hạng mục cảnh quan và hoạt động của Công viên Nghĩa Đô gồm hồ điều hòa, cầu đi bộ hình cây đàn, quảng trường trung tâm, khu vui chơi trẻ em, khu tập luyện thể dục thể thao và hệ thống đường dạo.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_infrastructure_components",
      "source": "src_government_inauguration",
      "topic": "supporting_infrastructure",
      "normalized_text": "Công viên Nghĩa Đô có hệ thống chiếu sáng, nhà bảo vệ, nhà điều hành, khu vệ sinh công cộng, nhà dịch vụ và nhà tập kết rác phục vụ quản lý, vận hành và sử dụng công viên.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_bridge_materials",
      "source": "src_tienphong_bridge",
      "topic": "bridge_materials",
      "normalized_text": "Cầu đi bộ hình cây đàn trong Công viên Nghĩa Đô sử dụng kết cấu thép định hình; móng và trụ cầu được làm bằng bê tông cốt thép; mặt cầu hoàn thiện bằng tấm nhựa giả gỗ trên sàn thép.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_visitor_activities",
      "source": "src_skds_renovated_components",
      "topic": "visitor_activities",
      "normalized_text": "Công viên Nghĩa Đô phục vụ các hoạt động đi bộ, tập luyện thể dục thể thao, vui chơi dành cho trẻ em, sinh hoạt cộng đồng ngoài trời, tham quan và chụp ảnh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_component_functions",
      "source": "src_skds_renovated_components",
      "topic": "component_functions",
      "normalized_text": "Hệ thống đường dạo của Công viên Nghĩa Đô được sử dụng cho hoạt động đi bộ; khu tập luyện phục vụ thể dục thể thao; khu vui chơi phục vụ trẻ em; quảng trường trung tâm phục vụ sinh hoạt cộng đồng ngoài trời.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_bridge_function",
      "source": "src_tienphong_bridge",
      "topic": "bridge_function",
      "normalized_text": "Cầu đi bộ hình cây đàn trong Công viên Nghĩa Đô kết nối các lối đi qua hồ, đồng thời phục vụ người dân và du khách tham quan, chụp ảnh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_start",
      "source": "src_tienphong_completion",
      "topic": "renovation_start",
      "normalized_text": "Công viên Nghĩa Đô bắt đầu được cải tạo, sửa chữa vào ngày 25 tháng 2 năm 2025; dự án nâng cấp các cổng, hàng rào, hồ nước, khu vui chơi, khu thể thao, đường dạo và các công trình phục vụ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_inauguration_and_status",
      "source": "src_government_inauguration",
      "topic": "inauguration_and_city_designation",
      "normalized_text": "Ngày 29 tháng 1 năm 2026, công trình cải tạo, sửa chữa Công viên Nghĩa Đô được khánh thành và gắn biển Công trình cấp Thành phố chào mừng thành công Đại hội đại biểu toàn quốc lần thứ XIV của Đảng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_management_and_person",
      "source": "src_government_inauguration",
      "topic": "management_and_inauguration_participant",
      "normalized_text": "Chính quyền phường Nghĩa Đô được yêu cầu nâng cao trách nhiệm quản lý, khai thác, bảo vệ cảnh quan, cây xanh và vệ sinh môi trường tại Công viên Nghĩa Đô; Nguyễn Thanh Tùng, Giám đốc Công an thành phố Hà Nội, tham dự và phát biểu tại lễ khánh thành công trình ngày 29 tháng 1 năm 2026.",
      "text_kind": "normalized_summary"
    }
  ],
