      "normalized_text": "Công viên Thanh Xuân còn được gọi là Công viên hồ điều hòa Nhân Chính; cổng chính của công viên hướng ra đường Hoàng Minh Giám, phường Thanh Xuân, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_construction_and_opening",
      "source": "src_government_opening_2018",
      "topic": "construction_and_public_opening",
      "normalized_text": "Công viên hồ điều hòa Nhân Chính được khởi công ngày 8 tháng 5 năm 2016 và chính thức mở cửa đón khách ngày 10 tháng 9 năm 2018.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_total_area_and_location",
      "source": "src_government_opening_2018",
      "topic": "total_area_and_location",
      "normalized_text": "Công viên hồ điều hòa Nhân Chính được xây dựng trên khu đất rộng khoảng 13,2 ha thuộc phường Nhân Chính, quận Thanh Xuân và một phần phường Trung Hòa, quận Cầu Giấy.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_functional_zones",
      "source": "src_government_opening_2018",
      "topic": "functional_zones_and_measurements",
      "normalized_text": "Công viên Thanh Xuân gồm Hồ điều hòa Nhân Chính rộng khoảng 8 ha và Khu công viên cây xanh Công viên Thanh Xuân cùng hạ tầng kỹ thuật, đường dạo rộng khoảng 5,23 ha.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_lake_fountain",
      "source": "src_government_opening_2018",
      "topic": "lake_fountain",
      "normalized_text": "Giữa Hồ điều hòa Nhân Chính có Đài phun nước nghệ thuật kết hợp với hệ thống chiếu sáng bằng đèn LED.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_landscape_components",
      "source": "src_environment_2018",
      "topic": "landscape_components",
      "normalized_text": "Các hạng mục cảnh quan của Công viên Thanh Xuân gồm Hệ thống đường dạo quanh hồ, Quảng trường trung tâm, Đài phun nước nghệ thuật, Khu vui chơi giải trí và khu đỗ xe.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_auxiliary_components",
      "source": "src_government_opening_2018",
      "topic": "auxiliary_components",
      "normalized_text": "Các công trình phụ trợ của Công viên Thanh Xuân gồm Nhà thuyền, Bến tàu, nhà chòi nghỉ và các cụm tiểu cảnh Công viên Thanh Xuân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_technical_components",
      "source": "src_procurement_2016",
      "topic": "technical_components",
      "normalized_text": "Các hạng mục của dự án Công viên hồ điều hòa Nhân Chính gồm Hồ điều hòa Nhân Chính, Trạm bơm, Khu công viên cây xanh và Nhà điều hành hai tầng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_tree_counts",
      "source": "src_government_opening_2018",
      "topic": "tree_counts",
      "normalized_text": "Công viên Thanh Xuân có hơn 1.300 cây, trong đó có 628 cây thân gỗ gồm các loài như muồng hoàng yến, phượng, sấu, xoài, hoàng lan và hoa anh đào.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_visitor_activities",
      "source": "src_government_opening_2018",
      "topic": "visitor_activities",
      "normalized_text": "Công viên Thanh Xuân phục vụ người dân nghỉ ngơi và thư giãn, vui chơi và giải trí, tổ chức hoạt động lễ hội và tập thể dục thể thao.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_walking_paths_use",
      "source": "src_environment_2018",
      "topic": "walking_paths_use",
      "normalized_text": "Hệ thống đường dạo quanh hồ Công viên Thanh Xuân được bố trí để người dân đi bộ và dạo quanh hồ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_component_uses",
      "source": "src_government_opening_2018",
      "topic": "component_uses",
      "normalized_text": "Khu công viên cây xanh Công viên Thanh Xuân phục vụ nghỉ ngơi thư giãn và tập thể dục thể thao; Quảng trường trung tâm phục vụ vui chơi, giải trí và hoạt động lễ hội; Khu vui chơi giải trí Công viên Thanh Xuân phục vụ hoạt động vui chơi và giải trí.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_lake_environmental_use",
      "source": "src_environment_2018",
      "topic": "lake_environmental_function",
      "normalized_text": "Hồ điều hòa Nhân Chính có diện tích mặt nước khoảng 8 ha và có công năng điều hòa không khí khu vực, góp phần tạo môi trường trong lành, tươi mát.",
      "text_kind": "normalized_summary"
    },
    {
