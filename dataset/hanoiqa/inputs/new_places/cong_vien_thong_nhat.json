      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_main_components",
      "source": "src_dantri_components",
      "topic": "lake_and_islands",
      "normalized_text": "Công viên Thống Nhất bao quanh Hồ Bảy Mẫu; trong Hồ Bảy Mẫu có hai hòn đảo là Đảo Hòa Bình và Đảo Thống Nhất.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_lake_area",
      "source": "src_dantri_components",
      "topic": "lake_area",
      "normalized_text": "Hồ Bảy Mẫu, một hạng mục thuộc Công viên Thống Nhất, có diện tích khoảng 25 hecta.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_island_and_bridge",
      "source": "src_dantri_components",
      "topic": "island_and_bridge",
      "normalized_text": "Đảo Thống Nhất trong Công viên Thống Nhất có diện tích hơn 6.000 mét vuông và được nối với khu vực phía đường Lê Duẩn bằng Cầu Thống Nhất.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recreation_components",
      "source": "src_dantri_components",
      "topic": "recreation_components",
      "normalized_text": "Công viên Thống Nhất có Sân khấu ngoài trời, Khu vui chơi thiếu nhi và Không gian đường dạo, cây xanh phục vụ người dân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_visitor_activities",
      "source": "src_thanh_nien_history",
      "topic": "visitor_activities",
      "normalized_text": "Khách đến Công viên Thống Nhất có thể tập thể dục, đi bộ, dạo chơi, nghỉ ngơi và thư giãn trong không gian cây xanh.",
      "text_kind": "normalized_summary"
    },
    {
