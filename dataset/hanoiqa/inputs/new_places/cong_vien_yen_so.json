  "evidence": [
    {
      "key": "ev_address",
      "source": "src_gamuda_overview",
      "topic": "address",
      "normalized_text": "Công viên Yên Sở nằm tại Quốc lộ 1A, phường Yên Sở, thành phố Hà Nội và gần nút giao Pháp Vân - Cầu Giẽ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_construction",
      "source": "src_gamuda_overview",
      "topic": "construction_and_developer",
      "normalized_text": "Dự án Công viên Yên Sở do Gamuda Land Việt Nam đầu tư xây dựng và được khởi công vào năm 2007.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_total_area",
      "source": "src_gamuda_overview",
      "topic": "total_area",
      "normalized_text": "Công viên Yên Sở có tổng diện tích 323 ha, trong đó khoảng 280 ha là diện tích cây xanh và mặt nước.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_lake_complex",
      "source": "src_vietnamplus_opening",
      "topic": "lake_complex",
      "normalized_text": "Cụm năm hồ Yên Sở là một hạng mục cảnh quan của Công viên Yên Sở; năm hồ đã được nạo vét, làm sạch để góp phần điều hòa môi trường khu vực.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_cultural_components",
      "source": "src_vnexpress_components",
      "topic": "cultural_components",
      "normalized_text": "Các hạng mục văn hóa và cảnh quan của Công viên Yên Sở gồm Nhà triển lãm nghệ thuật, Sân khấu ngoài trời, Vườn mê cung và Làng văn hóa.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recreation_components",
      "source": "src_vnexpress_components",
      "topic": "recreation_components",
      "normalized_text": "Các hạng mục phục vụ giải trí tại Công viên Yên Sở gồm Nhà thuyền, Khu thể dục thể thao, Khu cắm trại và dã ngoại cùng các không gian vui chơi, đi dạo ngoài trời.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_category_and_function",
      "source": "src_vietnamplus_opening",
      "topic": "category_and_function",
      "normalized_text": "Công viên Yên Sở là công viên đô thị và không gian xanh công cộng, phục vụ nhu cầu vui chơi, giải trí của người dân đồng thời hỗ trợ điều hòa môi trường phía Nam Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_exhibition_usage",
      "source": "src_vnexpress_components",
      "topic": "exhibition_activity",
      "normalized_text": "Nhà triển lãm nghệ thuật của Công viên Yên Sở được sử dụng cho hoạt động tham quan và thưởng thức triển lãm nghệ thuật.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_theater_usage",
      "source": "src_vnexpress_components",
      "topic": "outdoor_performance_activity",
      "normalized_text": "Sân khấu ngoài trời của Công viên Yên Sở là không gian phục vụ tổ chức và xem các chương trình biểu diễn ngoài trời.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_exercise_usage",
      "source": "src_vnexpress_components",
      "topic": "exercise_activity",
      "normalized_text": "Khu thể dục thể thao của Công viên Yên Sở phục vụ hoạt động tập thể dục và rèn luyện thể chất.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_camping_usage",
      "source": "src_vnexpress_components",
      "topic": "camping_activity",
      "normalized_text": "Khu cắm trại và dã ngoại của Công viên Yên Sở phục vụ hoạt động cắm trại, dã ngoại và sinh hoạt ngoài trời.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_children_walking_usage",
      "source": "src_yenso_handover",
      "topic": "children_and_walking_activities",
      "normalized_text": "Khu vui chơi trẻ em và hệ thống đường dạo tại Công viên Yên Sở phục vụ hoạt động vui chơi thiếu nhi, đi bộ và thư giãn của người dân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_opening",
      "source": "src_vietnamplus_opening",
      "topic": "official_opening",
      "normalized_text": "Sự kiện Khai trương Công viên Yên Sở diễn ra ngày 4 tháng 4 năm 2014, đánh dấu việc công viên chính thức mở cửa phục vụ người dân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_opening_persons",
      "source": "src_vietnamplus_opening",
      "topic": "opening_participants",
      "normalized_text": "Thủ tướng Malaysia Najib Razak và Bí thư Thành ủy Hà Nội Phạm Quang Nghị tham dự và thực hiện nghi thức cắt băng tại sự kiện Khai trương Công viên Yên Sở.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_gamuda_person",
      "source": "src_vietnamplus_opening",
      "topic": "developer_representative",
      "normalized_text": "Cheong Ho Kuan, Tổng giám đốc Gamuda Land Việt Nam, là nhân vật gắn với Công viên Yên Sở trong vai trò đại diện doanh nghiệp đầu tư phát triển dự án.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_management_handover",
      "source": "src_yenso_handover",
      "topic": "management_handover",
      "normalized_text": "Ngày 10 tháng 2 năm 2026, Công viên Yên Sở được bàn giao cho Ủy ban nhân dân phường Yên Sở quản lý; việc bàn giao gắn với đợt chỉnh trang công viên.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_works",
      "source": "src_yenso_handover",
      "topic": "renovation_works",
      "normalized_text": "Trong tháng 2 năm 2026, Ủy ban nhân dân phường Yên Sở thực hiện chỉnh trang Công viên Yên Sở, gồm tháo khoảng 300 m hàng rào, mở hai lối vào mới, cải tạo đường dạo và hoàn thiện khu vui chơi trẻ em.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_person",
      "source": "src_yenso_handover",
      "topic": "renovation_direction",
      "normalized_text": "Vũ Tuấn Đạt, Chủ tịch Ủy ban nhân dân phường Yên Sở, tham gia chỉ đạo sự kiện bàn giao và chỉnh trang Công viên Yên Sở năm 2026.",
      "text_kind": "normalized_summary"
    }
  ],
