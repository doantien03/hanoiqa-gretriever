  "evidence": [
    {
      "key": "ev_address",
      "source": "src_vietnamplus_heritage",
      "topic": "address",
      "normalized_text": "Đền Bạch Mã hiện tọa lạc duy nhất tại số 76 phố Hàng Buồm, phường Hoàn Kiếm, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_location_category",
      "source": "src_vietnamplus_heritage",
      "topic": "location_and_category",
      "normalized_text": "Đền Bạch Mã nằm trong khu phố cổ Hà Nội, là không gian văn hóa - tín ngưỡng và giữ vị trí trấn Đông trong hệ thống Thăng Long Tứ trấn.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_foundation_866",
      "source": "src_sovhtt_values",
      "topic": "foundation",
      "normalized_text": "Tài liệu lịch sử được giới thiệu tại tọa đàm khoa học cho biết Đền Bạch Mã được khởi dựng dưới thời nhà Đường, khi Cao Biền xây La Thành vào năm 866.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_founder_cao_bien",
      "source": "src_history_museum",
      "topic": "foundation_legend",
      "normalized_text": "Theo ghi chép và truyền thuyết được Bảo tàng Lịch sử Quốc gia giới thiệu, sau sự kiện trấn yểm không thành, Cao Biền đã lập đền thờ thần Long Đỗ tại khu vực thành Đại La.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_rebuild_1010",
      "source": "src_sovhtt_values",
      "topic": "reconstruction",
      "normalized_text": "Sau khi Lý Công Uẩn dời đô từ Hoa Lư ra xây thành Thăng Long năm 1010, Đền Bạch Mã được xây dựng lại.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_architecture",
      "source": "src_daibieunhandan",
      "topic": "architecture",
      "normalized_text": "Đợt tu bổ tổng thể Đền Bạch Mã gồm Nghi môn, Phương đình, Tiền tế và Hậu cung; kiến trúc hiện nay mang dấu ấn thế kỷ XIX thời Nguyễn, có bố cục chữ tam, phương đình tám mái và hệ mái hình vỏ cua liên kết các hạng mục.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_objects",
      "source": "src_sovhtt_award",
      "topic": "heritage_objects",
      "normalized_text": "Đền Bạch Mã lưu giữ tượng thần Long Đỗ có niên đại thế kỷ XVII, 18 bia đá cổ, 17 đạo sắc phong thời Nguyễn và tượng ngựa trắng bằng gỗ tượng trưng cho thần Bạch Mã.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_ancient_well",
      "source": "src_vietnamplus_heritage",
      "topic": "architecture",
      "normalized_text": "Phía sau Đền Bạch Mã có một giếng cổ, được giới thiệu là một trong số ít giếng cổ còn lại trong khu phố cổ Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_1687",
      "source": "src_sovhtt_tutran",
      "topic": "renovation",
      "normalized_text": "Nhiều hiện vật mang phong cách nghệ thuật cuối thế kỷ XVII tại Đền Bạch Mã được cho là đã được bổ sung trong đợt tu bổ năm Chính Hòa thứ 8, tức năm 1687.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation_2019",
      "source": "src_daibieunhandan",
      "topic": "renovation",
      "normalized_text": "Ủy ban nhân dân quận Hoàn Kiếm quyết định đầu tư tu bổ, tôn tạo tổng thể Đền Bạch Mã từ tháng 6 năm 2019; công trình cơ bản hoàn thành vào dịp kỷ niệm 1010 năm Thăng Long - Hà Nội tháng 10 năm 2020.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recognition_2022",
      "source": "src_sovhtt_award",
      "topic": "recognition",
      "normalized_text": "Ngày 18 tháng 1 năm 2022, Thủ tướng Chính phủ ký Quyết định số 93/QĐ-TTg xếp hạng Di tích lịch sử và kiến trúc nghệ thuật Thăng Long Tứ trấn, trong đó có Đền Bạch Mã, là Di tích quốc gia đặc biệt.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival_time",
      "source": "src_vietnamtourism_festival",
      "topic": "festival",
      "normalized_text": "Lễ hội Đền Bạch Mã diễn ra hằng năm vào ngày 12 và 13 tháng Hai âm lịch để tưởng nhớ công ơn của thần Long Đỗ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival_activity",
      "source": "src_vietnamtourism_festival",
      "topic": "activity",
      "normalized_text": "Hoạt động của lễ hội Đền Bạch Mã có tế lễ, dâng hương, rước kiệu, múa rồng, tiến Xuân Ngưu và biểu diễn nghệ thuật dân tộc.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_long_do",
      "source": "src_sovhtt_award",
      "topic": "worship",
      "normalized_text": "Đền Bạch Mã thờ thần Long Đỗ, vị thần được coi là Thành hoàng Thăng Long và trấn giữ phía Đông kinh thành.",
      "text_kind": "normalized_summary"
    }
  ],
