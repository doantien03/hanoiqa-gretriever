  "evidence": [
    {
      "key": "ev_address",
      "source": "src_ward_address_2026",
      "topic": "address",
      "normalized_text": "Cổng thông tin phường Hai Bà Trưng ghi địa chỉ hiện hành duy nhất của Di tích Đền - Chùa - Đình Hai Bà Trưng là số 12 phố Hương Viên, phường Hai Bà Trưng, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_identity_category",
      "source": "src_sovhtt_overview",
      "topic": "identity_and_category",
      "normalized_text": "Đền Đồng Nhân là tên gọi khác của Đền Hai Bà Trưng, một di tích lịch sử, kiến trúc và cơ sở tín ngưỡng thờ Trưng Trắc, Trưng Nhị tại phố Hương Viên.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_foundation",
      "source": "src_sovhtt_overview",
      "topic": "foundation",
      "normalized_text": "Theo sử liệu, năm Đại Định thứ 3 (1142), vua Lý Anh Tông truyền lập Đền Hai Bà Trưng tại bãi sông của làng Đồng Nhân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_relocation",
      "source": "src_sovhtt_history_architecture",
      "topic": "relocation",
      "normalized_text": "Năm Gia Long thứ 18 (1819), do bãi Đồng Nhân bị xói lở, dân làng di dời đền tới khu Cựu Võ Sở của triều Lê ở thôn Hương Viên, là vị trí hiện nay.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_architecture",
      "source": "src_sovhtt_overview",
      "topic": "architecture",
      "normalized_text": "Đền có diện tích khoảng 4.000 m², mang kiến trúc nội Công ngoại Quốc; phía trước có hồ bán nguyệt, nghi môn bốn trụ, phương đình hai tầng tám mái, tiền tế bảy gian, tòa thiêu hương và hậu cung.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_interior_objects",
      "source": "src_sovhtt_overview",
      "topic": "interior_objects",
      "normalized_text": "Tiền tế đặt đôi tượng voi gỗ sơn đen gắn ngà; tòa thiêu hương có ngai thờ và bức khảm Hai Bà cưỡi voi; hậu cung đặt tượng Trưng Trắc, Trưng Nhị cùng tượng các nữ tướng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_heritage_objects",
      "source": "src_sovhtt_tourism",
      "topic": "heritage_objects",
      "normalized_text": "Đền lưu giữ bộ sắc phong của các triều Lê và Nguyễn, hai pho tượng thờ Hai Bà, hai bia đá cổ, hai bộ kiệu thời Nguyễn cùng nhiều đồ thờ sơn son thếp vàng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_stele",
      "source": "src_sovhtt_history_architecture",
      "topic": "stele",
      "normalized_text": "Bia Trưng Vương sự tích bi ký đặt trước bái đường, do tiến sĩ Vũ Tông Phan soạn năm Minh Mệnh thứ 21 (1840), ca ngợi công trạng và khí tiết của Hai Bà Trưng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival",
      "source": "src_sovhtt_history_architecture",
      "topic": "festival",
      "normalized_text": "Hội Đền Đồng Nhân diễn ra từ chiều mùng 4 đến hết ngày 7 tháng Hai âm lịch, chính hội ngày 5 và 6; các hoạt động gồm rước nước, tế lễ, biểu diễn tái hiện Hai Bà cưỡi voi, đấu vật, múa roi và múa sư tử.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_water_ritual",
      "source": "src_sovhtt_history_architecture",
      "topic": "water_ritual",
      "normalized_text": "Trong lễ hội, nước được rước từ sông Hồng về nấu với trầm hương để thực hiện lễ Mộc dục, tức lễ tắm tượng Hai Bà Trưng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recognition",
      "source": "src_dsvh_recognition",
      "topic": "recognition",
      "normalized_text": "Ngày 31 tháng 12 năm 2019, Thủ tướng Chính phủ ký Quyết định số 1954/QĐ-TTg xếp hạng Di tích kiến trúc nghệ thuật Đền - Chùa - Đình Hai Bà Trưng là Di tích quốc gia đặc biệt.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_tourism_point",
      "source": "src_hanoi_tourism_decision",
      "topic": "tourism_point",
      "normalized_text": "Ủy ban nhân dân thành phố Hà Nội công nhận Di tích quốc gia đặc biệt Đền, Chùa, Đình Hai Bà Trưng tại số 12 phố Hương Viên là điểm du lịch của thành phố.",
      "text_kind": "normalized_summary"
    }
  ],
