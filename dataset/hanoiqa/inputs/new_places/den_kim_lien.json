  "evidence": [
    {
      "key": "ev_address",
      "source": "src_local_festival_2026",
      "topic": "address",
      "normalized_text": "Cổng thông tin phường Văn Miếu - Quốc Tử Giám ghi địa chỉ hiện hành duy nhất của Đền Kim Liên là số 148 phố Kim Hoa, phường Văn Miếu - Quốc Tử Giám, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_identity_category",
      "source": "src_local_intro_2026",
      "topic": "identity_and_category",
      "normalized_text": "Đền Kim Liên, còn gọi là Đình Kim Liên hoặc Đền Cao Sơn, là di tích lịch sử - văn hóa và cơ sở thờ thần Cao Sơn Đại Vương, giữ vai trò trấn phía Nam kinh thành Thăng Long.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_location_landscape",
      "source": "src_local_intro_2026",
      "topic": "location_and_landscape",
      "normalized_text": "Đền Kim Liên được xây trên gò đất cao, cách La Thành khoảng 100 m về phía Đông đầm Kim Liên xưa; cổng và chính điện hướng về phía Tây.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_foundation_1509",
      "source": "src_government_festival",
      "topic": "foundation",
      "normalized_text": "Năm 1509, vua Lê Tương Dực cho xây dựng Đền Kim Liên để thờ thần Cao Sơn Đại Vương; di tích trở thành trấn phía Nam của kinh thành Thăng Long.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_architecture_parts",
      "source": "src_local_intro_2026",
      "topic": "architecture_components",
      "normalized_text": "Khu phía trước có Nghi môn Ngoại, hai dãy Tả - Hữu vu, sân, hồ bán nguyệt và giếng ngọc; khu kiến trúc cổ trên gò gồm Nghi môn Nội, Đại bái, Hậu cung, nhà Mẫu, bia thần tích và sân vườn.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_steps_material",
      "source": "src_local_intro_2026",
      "topic": "steps_and_material",
      "normalized_text": "Hai khu kiến trúc được nối bằng chín bậc cao xây bằng gạch vồ thời Lê Trung Hưng, loại gạch đất nung có kích thước lớn và dày.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_architecture_style",
      "source": "src_sovhtt_architecture",
      "topic": "architectural_style",
      "normalized_text": "Kiến trúc Đền Kim Liên mang dấu ấn rõ nét của nghệ thuật thời Nguyễn; Nghi môn xây kiểu tường hồi bít đốc, còn Đại bái được tôn tạo theo kiểu dáng kiến trúc truyền thống.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_worship_persons",
      "source": "src_local_intro_2026",
      "topic": "worship",
      "normalized_text": "Đền chính thờ Cao Sơn Đại Vương và phối thờ Thủy Tinh công chúa cùng Huệ Minh phu nhân.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_stele",
      "source": "src_local_intro_2026",
      "topic": "stele",
      "normalized_text": "Bia đá Cao Sơn Đại Vương thần từ bi minh tịnh tự do sử thần Lê Tung soạn năm Canh Ngọ, niên hiệu Hồng Thuận thứ 3 (1510), ghi công thần Cao Sơn và lịch sử của di tích.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_decrees",
      "source": "src_local_intro_2026",
      "topic": "royal_decrees",
      "normalized_text": "Theo hồ sơ giới thiệu năm 2026, Đền Kim Liên hiện lưu giữ 33 đạo sắc phong cho thần Cao Sơn, gồm 22 sắc thời Lê và 11 sắc thời Nguyễn, cùng 5 bản sao sắc phong.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation",
      "source": "src_local_intro_2026",
      "topic": "renovation",
      "normalized_text": "Đền Kim Liên được tu bổ, tôn tạo quy mô trong giai đoạn 2008-2010 để chuẩn bị kỷ niệm 1000 năm Thăng Long - Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival",
      "source": "src_government_festival",
      "topic": "festival",
      "normalized_text": "Lễ hội Đền Kim Liên được tổ chức hằng năm vào ngày 16 tháng Ba âm lịch, ngày sinh Đức thần Cao Sơn, với nghi lễ, rước kiệu và các trò chơi dân gian truyền thống.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_death_anniversary",
      "source": "src_local_intro_2026",
      "topic": "death_anniversary",
      "normalized_text": "Hằng năm vào ngày 12 tháng Tám âm lịch, ngày hóa của Đức thần Cao Sơn, Đền Kim Liên tổ chức tế lễ và dâng hương tưởng niệm.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recognition",
      "source": "src_dsvh_decision",
      "topic": "recognition",
      "normalized_text": "Ngày 18 tháng 1 năm 2022, Thủ tướng Chính phủ ký Quyết định số 93/QĐ-TTg xếp hạng Di tích lịch sử và kiến trúc nghệ thuật Thăng Long tứ trấn, gồm Đền Kim Liên, là Di tích quốc gia đặc biệt.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_community_role",
      "source": "src_local_intro_2026",
      "topic": "community_role",
      "normalized_text": "Trong lịch sử, Đền Kim Liên được dùng làm trung tâm giải quyết và tổ chức những việc lớn của làng, vì vậy mang thêm chức năng của một ngôi đình và được gọi là Đình Kim Liên.",
      "text_kind": "normalized_summary"
    }
  ],
