  "evidence": [
    {
      "key": "ev_street_address",
      "source": "src_vietnam_airlines_address",
      "topic": "address",
      "normalized_text": "Nguồn du lịch của Vietnam Airlines ghi Đền Voi Phục tại số 306B phố Kim Mã; đây là địa chỉ đường phố chi tiết duy nhất được dùng cho địa danh trong bộ dữ liệu.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_current_ward",
      "source": "src_giangvo_current",
      "topic": "current_administrative_area",
      "normalized_text": "Cổng thông tin chính quyền phường Giảng Võ xác nhận Di tích Đền Voi Phục hiện thuộc địa bàn phường Giảng Võ, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_names_location",
      "source": "src_history_museum",
      "topic": "names_and_location",
      "normalized_text": "Bảo tàng Lịch sử Quốc gia giới thiệu Đền Voi Phục còn gọi là Đền Linh Lang, nằm tại khu vực Công viên Thủ Lệ và là ngôi đền trấn giữ phía Tây kinh thành Thăng Long.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_foundation",
      "source": "src_hanoi_tutran",
      "topic": "foundation",
      "normalized_text": "Cổng thông tin thành phố Hà Nội cho biết Đền Voi Phục, còn gọi Đền Thủ Lệ hoặc Đền Linh Lang, được xây dựng năm Chương Thánh Gia Khánh thứ 7 (1065), đời vua Lý Thánh Tông.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_worship",
      "source": "src_sovhtt_festival",
      "topic": "worship_and_category",
      "normalized_text": "Đền Voi Phục là cơ sở tín ngưỡng thuộc Thăng Long tứ trấn, được vua Lý Thánh Tông cho xây trên gò Long Thủ để thờ Đức Thánh Linh Lang Đại Vương, người được tưởng niệm vì công đánh giặc và bảo vệ đất nước.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_entrance_architecture",
      "source": "src_sovhtt_architecture",
      "topic": "entrance_architecture",
      "normalized_text": "Nghi môn Đền Voi Phục có dạng tứ trụ; hai bên có bia hạ mã và đôi voi chầu phục. Đường lên sân gồm ba lối, trong đó lối giữa có 12 bậc đá rộng và dành để rước kiệu trong ngày lễ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_well_dragons",
      "source": "src_sovhtt_architecture",
      "topic": "well_and_stone_carving",
      "normalized_text": "Phía trước lối đi giữa có giếng vuông xưa dùng lấy nước cúng; gần đó là đôi rồng mây chạm tròn bằng đá có niên đại khoảng giữa thế kỷ XIX.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_main_architecture",
      "source": "src_sovhtt_architecture",
      "topic": "main_architecture",
      "normalized_text": "Đền chính có dạng chữ Công; tiền tế gồm năm gian, kết cấu vì chồng rường và lợp ngói mũi hài cổ; trung đường là một gian chạy dọc nối vào hậu cung năm gian.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_interior_objects",
      "source": "src_sovhtt_architecture",
      "topic": "interior_objects",
      "normalized_text": "Trong đền có ngai lớn chạm rồng và hoa lá, tượng hai vị tùy tướng quỳ chầu, tượng Đức Linh Lang Đại Vương, hòn đá có vết lõm đặt trong hộp kính, tượng hai vị phụ tá đứng chầu cùng nhóm hoành phi, câu đối, nhang án, long ngai, cửa võng bát bửu và đồ tế khí sơn son thếp vàng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival_time",
      "source": "src_sovhtt_festival",
      "topic": "festival_time",
      "normalized_text": "Hằng năm vào ngày 10 tháng Hai âm lịch, người dân tổ chức lễ hội truyền thống kỷ niệm Ngày hóa Đức Thánh Linh Lang Đại Vương tại Đền Voi Phục.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival_activities",
      "source": "src_sovhtt_festival",
      "topic": "festival_activities",
      "normalized_text": "Lễ hội Đền Voi Phục có rước kiệu; phần hội tổ chức trò chơi dân gian, hát quan họ và ca múa nhạc chào mừng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recognition",
      "source": "src_dsvh_decision",
      "topic": "recognition",
      "normalized_text": "Ngày 18 tháng 1 năm 2022, Thủ tướng Chính phủ ký Quyết định số 93/QĐ-TTg xếp hạng Di tích lịch sử và kiến trúc nghệ thuật Thăng Long tứ trấn, gồm Đền Voi Phục, là Di tích quốc gia đặc biệt.",
      "text_kind": "normalized_summary"
    }
  ],
