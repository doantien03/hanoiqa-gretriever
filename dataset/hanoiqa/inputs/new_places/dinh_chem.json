  "evidence": [
    {
      "key": "address",
      "source": "src_local",
      "topic": "address",
      "normalized_text": "Đình Chèm nằm tại làng Chèm, nay thuộc phường Đông Ngạc, thành phố Hà Nội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "category",
      "source": "src_local",
      "topic": "category",
      "normalized_text": "Đình Chèm là công trình tín ngưỡng có giá trị kiến trúc nghệ thuật.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "honors",
      "source": "src_festival",
      "topic": "worship",
      "normalized_text": "Hai vị được thờ tại Đình Chèm là Lý Ông Trọng và Bạch Tĩnh Cung.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "dating",
      "source": "src_dsvh",
      "topic": "historical_architecture",
      "normalized_text": "Kiến trúc hiện còn của Đình Chèm có nguồn gốc thời Lê Trung Hưng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "architecture",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Đình Chèm bố trí theo kiểu nội Công ngoại Quốc; có nghi môn nội, phương đình, đại bái, hậu cung và hai nhà bia.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "inner",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Hậu cung gồm Cung đệ nhất, Cung đệ nhị (ống muống) và Cung cấm.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "phuong",
      "source": "src_dsvh",
      "topic": "renovation_and_function",
      "normalized_text": "Phương đình được dựng lại năm 1989 và dùng làm lễ tắm tượng trước hội.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "steles",
      "source": "src_dsvh",
      "topic": "associated_person",
      "normalized_text": "Nghiêm Xuân Quảng soạn hai bia năm 1917, ghi công Thánh Chèm và việc nâng đình.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "lift",
      "source": "src_dsvh",
      "topic": "renovation",
      "normalized_text": "Năm 1916, đình được nâng thêm 2,4 m; hậu cung còn ghi niên đại tu sửa cùng năm.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "trieu",
      "source": "src_history",
      "topic": "renovation_tradition",
      "normalized_text": "Theo thần tích, năm 785 thời Đường, Triệu Xương sửa miếu thờ Lý Ông Trọng thành nhà cao tầng chồng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "cao",
      "source": "src_history",
      "topic": "renovation_tradition",
      "normalized_text": "Theo thần tích, năm 864, Cao Biền mở rộng đền thờ Lý Ông Trọng, cho tạc tượng gỗ và sơn son thếp vàng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "recognition",
      "source": "src_recognition",
      "topic": "recognition",
      "normalized_text": "Đình Chèm được xếp hạng di tích quốc gia đặc biệt theo Quyết định 2082/QĐ-TTg ngày 25/12/2017 của Thủ tướng Chính phủ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "management",
      "source": "src_local",
      "topic": "management",
      "normalized_text": "Ban Quản lý di tích Đình Chèm tham gia quản lý và bảo tồn đình; trưởng Ban Khánh tiết đồng thời là phó ban quản lý.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "festival",
      "source": "src_local",
      "topic": "festival",
      "normalized_text": "Lễ hội Đình Chèm tổ chức hằng năm từ 14 đến 16 tháng Năm âm lịch, có nghi thức tắm tượng và rước nước sông Hồng.",
      "text_kind": "normalized_summary"
    }
  ],
