    },
    {
      "key": "ev_category",
      "source": "src_quangoai",
      "topic": "category",
      "normalized_text": "Đình Tây Đằng là di tích kiến trúc nghệ thuật và nơi thờ Thánh Tản Viên.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_honors",
      "source": "src_dsvh",
      "topic": "worship",
      "normalized_text": "Ba Thành hoàng được thờ ở đình Tây Đằng là Tản Viên, Cao Sơn, Quý Minh.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_dating",
      "source": "src_dsvh",
      "topic": "dating",
      "normalized_text": "Niên đại khởi dựng đình Tây Đằng được nhận định là thế kỷ XVI, thời Mạc.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_renovation",
      "source": "src_dsvh",
      "topic": "renovation",
      "normalized_text": "Đình Tây Đằng được tu bổ trong giai đoạn 2002-2004.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_components",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Quần thể đình Tây Đằng gồm cổng, hồ bán nguyệt, nghi môn, tả mạc, hữu mạc, đại đình và giếng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_auxiliary",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Tả mạc và hữu mạc được dựng năm 1860, mái dùng ngói mũi hài.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_main",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Đại đình có mặt bằng chữ Nhất, mái ngói mũi hài; phần lớn cấu kiện gỗ dùng gỗ mít.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_inner",
      "source": "src_dsvh",
      "topic": "worship_architecture",
      "normalized_text": "Hậu cung nằm trong đại đình, đặt ba ngai thờ Thành hoàng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_yard",
      "source": "src_dsvh",
      "topic": "architecture",
      "normalized_text": "Sân sau nghi môn lát gạch Bát Tràng. Nghi môn có dạng tứ trụ.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_community",
      "source": "src_dsvh",
      "topic": "function",
      "normalized_text": "Các gian bên của đại đình dành không gian sinh hoạt văn hóa cộng đồng.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_recognition",
      "source": "src_recognition",
      "topic": "recognition",
      "normalized_text": "Đình Tây Đằng được Thủ tướng Chính phủ xếp hạng di tích quốc gia đặc biệt ngày 9/12/2013, theo Quyết định 2383/QĐ-TTg.",
      "text_kind": "normalized_summary"
    },
    {
      "key": "ev_festival",
      "source": "src_festival",
      "topic": "festival",
      "normalized_text": "Lễ hội Đình Tây Đằng Xuân Bính Ngọ khai mạc ngày 27/2/2026; nghi lễ có dâng hương tưởng nhớ Thánh Tản Viên.",
      "text_kind": "normalized_summary"
    }
